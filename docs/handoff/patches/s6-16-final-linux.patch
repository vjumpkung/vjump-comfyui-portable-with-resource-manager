+fn install_async_runtime() {
+    // Never dropped: tauri::async_runtime::set takes only a Handle.
+    static RUNTIME: OnceLock<tokio::runtime::Runtime> = OnceLock::new();
+    let runtime = RUNTIME.get_or_init(|| {
+        async_runtime_builder()
+            .build()
