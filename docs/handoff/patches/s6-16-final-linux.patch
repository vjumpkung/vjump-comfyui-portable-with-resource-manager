+        "python".into(),
+        "install".into(),
+        version.to_string().into(),
+        "--no-bin".into(),
+        "--no-registry".into(),
+        "--python-downloads-json-url".into(),
+        metadata.as_os_str().to_owned(),
+    ]
+}
