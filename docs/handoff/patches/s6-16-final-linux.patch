+        assert_eq!(previews.len(), 2);
+        let post_hook = &previews[1];
+        assert_eq!(post_hook.requirements, ["registry-dep>=1", "numpy==2.2.0"]);
+        assert_eq!(&*post_hook.guarded.as_ref().unwrap().text, b"numpy\n");
+        assert_eq!(h.world.count("hook:run"), 1);
