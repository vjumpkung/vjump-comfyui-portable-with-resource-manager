+    let mut fa3 = accelerator("flashattention-3");
+    fa3.modules.clear();
+    fa3.provenance = "Module unverified; candidate flash_attn_interface".into();
+    world.profiles.lock().unwrap()[0].accelerators = vec![accelerator("sageattention"), fa3];
