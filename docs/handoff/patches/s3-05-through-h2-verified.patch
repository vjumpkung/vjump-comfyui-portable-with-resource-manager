+++ b/crates/desktop/src/diagnostics/tests.rs
@@ -0,0 +1,188 @@
+use std::{path::PathBuf, sync::Mutex};
+
+use application::settings::diagnostics::{
+    ComfySection, DiagnosticsSnapshot, EnvironmentSection, ManifestSection, PinnedTool,
+};
+use infrastructure::shared::logging::register_secret;
+
+use super::*;
+
+fn root() -> PathBuf {
+    PathBuf::from(if cfg!(windows) {
+        r"C:\Users\someone\vjump install ไทย"
+    } else {
+        "/home/someone/vjump install ไทย"
+    })
+}
+
+/// A secret-bearing value for `section`, in a form the shared redactor must recognise.
+fn leak(section: &str) -> String {
+    format!("https://host.test/file?safe=1&X-Amz-Signature=sec-{section}&token=sec-{section}-t")
+}
+
+/// Every part of the report carries a secret, an authorization header or a path in the root.
+fn snapshot_with_a_secret_everywhere() -> DiagnosticsSnapshot {
+    let root = root();
+    let inside = |tail: &str| format!("{}/{tail}", root.display());
+    DiagnosticsSnapshot {
+        app_version: format!("1.0.0 {}", leak("version")),
+        os: format!("Windows {}", leak("os")),
+        gpus: vec![format!("GPU {}", leak("gpu"))],
+        driver_version: Some(format!("591 {}", leak("driver"))),
+        driver_cuda: Some(format!("13.1 {}", leak("cuda"))),
+        environment: Some(EnvironmentSection {
+            id: inside("envs/main"),
+            ownership: format!("app_owned {}", leak("ownership")),
+            state: format!("verified {}", leak("state")),
+            python: format!("3.13.16 {}", leak("python")),
+            python_source: format!("managed {}", leak("source")),
+            profile_id: format!("profile {}", leak("profile")),
+            profile_revision: 1,
+            profile_label: Some(format!("label {}", leak("label"))),
+            cuda_variant: Some(format!("cu130 {}", leak("variant"))),
+            torch: Some(format!("2.14.1 {}", leak("torch"))),
+            triton: Some(format!("3.8.0 {}", leak("triton"))),
+            protected_pins: vec![("torch".into(), format!("2.14.1 {}", leak("pin")))],
+            accelerators: vec![format!("sageattention failed {}", leak("accelerator"))],
+        }),
+        manifest: Some(ManifestSection {
+            profile_id: format!("manifest {}", leak("manifest")),
+            profile_revision: 2,
+        }),
+        comfyui: ComfySection {
+            revision: Some(format!("abc123 {}", leak("revision"))),
+            status: Some(format!("stopped {}", leak("status"))),
+        },
+        tools: vec![PinnedTool {
+            name: "uv".into(),
+            version: format!("0.13.1 {}", leak("tool")),
+        }],
+        app_log: vec![
+            format!("opened {}", inside("data/app.db")),
+            format!(
+                "Authorization: Bearer sec-app-log-bearer {}",
+                leak("app-log")
+            ),
+        ],
+        runtime_log: vec![
+            format!("loading {}", inside("models/a.safetensors")),
+            format!("hf_{} {}", "a".repeat(30), leak("runtime-log")),
+        ],
+        warnings: vec![format!("warning {}", leak("warning"))],
+    }
+}
+
+fn report() -> String {
+    finalize(&snapshot_with_a_secret_everywhere().render(), &root())
+}
+
+#[derive(Default)]
+struct Recording {
+    written: Mutex<Vec<String>>,
+}
+
+impl Clipboard for Recording {
+    fn write_text(&self, text: &str) -> Result<(), ClipboardError> {
+        self.written.lock().unwrap().push(text.to_owned());
+        Ok(())
+    }
+}
+
+struct Failing;
+
+impl Clipboard for Failing {
+    fn write_text(&self, _: &str) -> Result<(), ClipboardError> {
+        Err(ClipboardError)
+    }
+}
+
+fn assert_clean(text: &str) {
+    for leaked in ["sec-", "hf_aaaa"] {
+        assert!(!text.contains(leaked), "`{leaked}` leaked:\n{text}");
+    }
+    let root = root();
+    let root = root.display().to_string();
+    assert!(!text.contains(&root), "the install root leaked:\n{text}");
+    assert!(!text.contains(&root.replace('\\', "/")));
+}
+
+#[test]
+fn diagnostics_redacts_every_section_and_clipboard_payload() {
+    register_secret("registered-session-secret-value");
+    let mut snapshot = snapshot_with_a_secret_everywhere();
+    snapshot
+        .warnings
+        .push("also registered-session-secret-value".into());
+    let text = finalize(&snapshot.render(), &root());
+
+    assert_clean(&text);
+    // Safe context survives: only the credentials and the root are replaced.
+    assert!(text.contains("safe=1"), "{text}");
+    assert!(text.contains("<root>/data/app.db"), "{text}");
+    assert!(text.contains("<root>/models/a.safetensors"), "{text}");
+    assert!(text.contains("ID: <root>/envs/main"), "{text}");
+    assert!(!text.contains("registered-session-secret-value"));
+    for header in [
+        "App version",
+        "== Environment ==",
+        "== Install manifest ==",
+        "== ComfyUI ==",
+        "== Tool versions ==",
+        "== Availability warnings ==",
+        "== Application log",
+        "== ComfyUI runtime log",
+    ] {
+        assert!(text.contains(header), "{header} missing:\n{text}");
+    }
+
+    // The clipboard receives exactly the redacted text that is returned.
+    let clipboard = Arc::new(Recording::default());
+    let outcome = tauri::async_runtime::block_on(copy_report(clipboard.clone(), text.clone()));
+    assert!(outcome.copied);
+    assert_eq!(outcome.text, text);
+    assert_eq!(*clipboard.written.lock().unwrap(), [text]);
+}
+
+#[test]
+fn clipboard_failure_returns_selectable_redacted_text() {
+    let text = report();
+    assert_clean(&text);
+
+    let outcome = tauri::async_runtime::block_on(copy_report(Arc::new(Failing), text.clone()));
+    assert!(!outcome.copied);
+    assert_eq!(outcome.text, text);
+    assert_clean(&outcome.text);
+    assert!(
+        UnavailableClipboard.write_text(&text).is_err(),
+        "the fallback clipboard never claims success"
+    );
+}
+
+#[test]
+fn install_root_is_presented_as_root_in_every_spelling() {
+    let root = root();
+    let shown = root.display().to_string();
+    let forward = shown.replace('\\', "/");
+    let backward = shown.replace('/', "\\");
+    let text = format!(
+        "a {shown}\\x b {forward}/y c \\\\?\\{backward}\\z d {shown} e {}-suffix",
+        shown.to_uppercase()
+    );
+    let replaced = replace_root(&text, &root);
+    assert!(replaced.starts_with("a <root>\\x b <root>/y c <root>\\z d <root> e "));
+    if cfg!(windows) {
+        assert!(replaced.ends_with("e <root>-suffix"), "{replaced}");
+    }
+    assert!(!replaced.contains(&shown));
+    assert!(!replaced.contains(&forward));
+
+    // Nothing is rewritten when no root is known.
+    assert_eq!(
+        replace_root("keep / and \\", Path::new("")),
+        "keep / and \\"
+    );
+    assert_eq!(
+        replace_root("keep / and \\", Path::new("/")),
+        "keep / and \\"
+    );
+}
diff --git a/crates/desktop/src/ipc/app_commands.rs b/crates/desktop/src/ipc/app_commands.rs
new file mode 100644
index 0000000..27a58ae
--- /dev/null
+++ b/crates/desktop/src/ipc/app_commands.rs
@@ -0,0 +1,87 @@
+//! Application-level commands: signed self-update and diagnostics. Plugin access stays on the
+//! Rust side; no capability grants the updater or clipboard plugin commands to a webview.
+
+use std::sync::Arc;
+
+use application::settings::updates::{UpdateProgress, UpdateProgressSink};
+use tauri::{State, ipc::Channel};
+
+use super::{
+    app_dto::{CopyDiagnosticsDto, UpdateOfferDto, UpdateProgressDto, UpdateStatusDto},
+    error::IpcError,
+};
+use crate::{
+    diagnostics::{collect_report, copy_report},
+    state::AppState,
+};
+
+/// Forwards progress to the UI. A channel the UI has lost drops events: the installation goes on.
+struct ChannelSink(Channel<UpdateProgressDto>);
+
+impl UpdateProgressSink for ChannelSink {
+    fn report(&self, progress: UpdateProgress) {
+        let _ = self.0.send(UpdateProgressDto::from(progress));
+    }
+}
+
+#[tauri::command]
+#[specta::specta]
+pub async fn app_update_status(state: State<'_, AppState>) -> Result<UpdateStatusDto, IpcError> {
+    Ok(UpdateStatusDto {
+        configured: state.updater().configured(),
+        current_version: env!("CARGO_PKG_VERSION").to_owned(),
+    })
+}
+
+/// Looks for a newer signed release. The offer it returns replaces every earlier one.
+#[tauri::command]
+#[specta::specta]
+pub async fn app_update_check(
+    state: State<'_, AppState>,
+) -> Result<Option<UpdateOfferDto>, IpcError> {
+    let offer = state.updater().check().await?;
+    Ok(offer.map(UpdateOfferDto::from))
+}
+
+/// Installs the release the user reviewed, named by the `update_id` of its offer. Success means
+/// the application is restarting.
+#[tauri::command]
+#[specta::specta]
+pub async fn app_update_install(
+    state: State<'_, AppState>,
+    update_id: String,
+    on_event: Channel<UpdateProgressDto>,
+) -> Result<(), IpcError> {
+    let services = state.services()?;
+    let updater = state.updater();
+    services
+        .install_update
+        .execute(
+            updater.as_ref(),
+            &update_id,
+            Arc::new(ChannelSink(on_event)),
+        )
+        .await?;
+    Ok(())
+}
+
+#[tauri::command]
+#[specta::specta]
+pub async fn app_diagnostics(state: State<'_, AppState>) -> Result<String, IpcError> {
+    Ok(collect_report(&state).await)
+}
+
+/// Collects the same redacted report, puts it on the clipboard and returns it, so the UI can
+/// offer it for manual selection when the clipboard is unavailable.
+#[tauri::command]
+#[specta::specta]
+pub async fn app_copy_diagnostics(
+    state: State<'_, AppState>,
+) -> Result<CopyDiagnosticsDto, IpcError> {
+    let text = collect_report(&state).await;
+    let outcome = copy_report(state.clipboard(), text).await;
+    Ok(CopyDiagnosticsDto {
+        text: outcome.text,
+        copied: outcome.copied,
+    })
+}
diff --git a/crates/desktop/src/ipc/app_dto.rs b/crates/desktop/src/ipc/app_dto.rs
new file mode 100644
index 0000000..3bce46e
--- /dev/null
+++ b/crates/desktop/src/ipc/app_dto.rs
@@ -0,0 +1,158 @@
+//! IPC DTOs of the application-level commands: signed self-update and diagnostics. Byte counts
+//! are `f64` because JavaScript numbers are exact up to 2^53 and no installer is that large.
+
+use application::settings::updates::{UpdateError, UpdateOffer, UpdateProgress};
+use serde::{Deserialize, Serialize};
+use specta::Type;
+
+use super::error::IpcError;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub struct UpdateStatusDto {
+    /// False when this build carries no complete signed-update configuration.
+    pub configured: bool,
+    pub current_version: String,
+}
+
+/// A newer release for the user to review. `update_id` must be echoed back to install exactly
+/// this release.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub struct UpdateOfferDto {
+    pub update_id: String,
+    pub version: String,
+    pub date: Option<String>,
+    /// Plain text from the update server; never markup.
+    pub notes: Option<String>,
+}
+
+impl From<UpdateOffer> for UpdateOfferDto {
+    fn from(offer: UpdateOffer) -> Self {
+        Self {
+            update_id: offer.update_id,
+            version: offer.version,
+            date: offer.date,
+            notes: offer.notes,
+        }
+    }
+}
+
+/// Installation progress. `failed` carries the stable error code of the failure.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, Type)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum UpdateProgressDto {
+    #[serde(rename_all = "camelCase")]
+    Downloading {
+        downloaded_bytes: f64,
+        total_bytes: Option<f64>,
+    },
+    Installing,
+    Restarting,
+    Failed {
+        code: String,
+    },
+}
+
+impl From<UpdateProgress> for UpdateProgressDto {
+    fn from(progress: UpdateProgress) -> Self {
+        match progress {
+            UpdateProgress::Downloading { downloaded, total } => Self::Downloading {
+                downloaded_bytes: downloaded as f64,
+                total_bytes: total.map(|total| total as f64),
+            },
+            UpdateProgress::Installing => Self::Installing,
+            UpdateProgress::Restarting => Self::Restarting,
+            UpdateProgress::Failed(error) => Self::Failed {
+                code: error.code().to_owned(),
+            },
+        }
+    }
+}
+
+/// The redacted report and whether it reached the system clipboard. When `copied` is false the
+/// UI shows `text` for manual selection.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, Type)]
+#[serde(rename_all = "camelCase")]
+pub struct CopyDiagnosticsDto {
+    pub text: String,
+    pub copied: bool,
+}
+
+impl From<UpdateError> for IpcError {
+    fn from(error: UpdateError) -> Self {
+        use application::{comfy_runtime::RuntimeBlock, shared::GateError};
+        let message = match error {
+            UpdateError::NotConfigured => "This build has no signed update source configured.",
+            UpdateError::Stale => {
+                "The reviewed update is no longer available. Check for updates again."
+            }
+            UpdateError::CheckFailed => "The update server could not be checked.",
+            UpdateError::SignatureInvalid => {
+                "The downloaded update failed signature verification and was not installed."
+            }
+            UpdateError::InstallFailed => {
+                "The update could not be downloaded or installed. Restart the app before trying again."
+            }
+            UpdateError::Gate(GateError::Busy) => {
+                "Another maintenance operation is running. Wait for it to finish."
+            }
+            UpdateError::Gate(GateError::Unavailable) => "The maintenance gate is unavailable.",
+            UpdateError::Runtime(RuntimeBlock::Running) => {
+                "ComfyUI from this installation is running. Stop it first."
+            }
+            UpdateError::Runtime(RuntimeBlock::CannotAssess) => {
+                "The state of ComfyUI could not be determined, so nothing was changed."
+            }
+        };
+        Self::new(error.code(), message)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn progress_serializes_as_the_documented_union() {
+        let json = |progress: UpdateProgress| {
+            serde_json::to_value(UpdateProgressDto::from(progress)).unwrap()
+        };
+        assert_eq!(
+            json(UpdateProgress::Downloading {
+                downloaded: 5,
+                total: None
+            }),
+            serde_json::json!({ "kind": "downloading", "downloadedBytes": 5.0, "totalBytes": null })
+        );
+        assert_eq!(
+            json(UpdateProgress::Installing),
+            serde_json::json!({ "kind": "installing" })
+        );
+        assert_eq!(
+            json(UpdateProgress::Restarting),
+            serde_json::json!({ "kind": "restarting" })
+        );
+        assert_eq!(
+            json(UpdateProgress::Failed(UpdateError::SignatureInvalid)),
+            serde_json::json!({ "kind": "failed", "code": "update_signature_invalid" })
+        );
+    }
+
+    #[test]
+    fn every_update_error_has_its_code_and_a_sanitized_message() {
+        for error in [
+            UpdateError::NotConfigured,
+            UpdateError::Stale,
+            UpdateError::CheckFailed,
+            UpdateError::SignatureInvalid,
+            UpdateError::InstallFailed,
+            UpdateError::Gate(application::shared::GateError::Busy),
+            UpdateError::Runtime(application::comfy_runtime::RuntimeBlock::Running),
+        ] {
+            let ipc = IpcError::from(error);
+            assert_eq!(ipc.code, error.code());
+            assert!(!ipc.message.is_empty());
+        }
+    }
+}
