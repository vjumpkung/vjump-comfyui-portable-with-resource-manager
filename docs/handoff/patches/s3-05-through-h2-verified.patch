+  fireEvent.click(screen.getByRole('button', { name: /install and restart/i }))
+  await waitFor(() => expect(gateway.appUpdateInstall).toHaveBeenCalledTimes(1))
+  expect(gateway.appUpdateInstall).toHaveBeenCalledWith(
+    'update-7',
+    expect.any(Function),
