diff --git a/crates/infrastructure/src/shared/log_tail.rs b/crates/infrastructure/src/shared/log_tail.rs
new file mode 100644
index 0000000..de3ca48
--- /dev/null
+++ b/crates/infrastructure/src/shared/log_tail.rs
@@ -0,0 +1,119 @@
+//! Bounded reads of the newest application log lines for diagnostics.
+//!
+//! The log rotates through `app.log`, `app.log.1` and so on (see `logging::init`). The tail is
+//! bounded by lines and by bytes, so a huge or pathological log can never be read whole, and it
+//! is read on a blocking thread so the async runtime and the UI stay responsive.
+
+use std::{
+    fs::File,
+    io::{Read, Seek, SeekFrom},
+    path::{Path, PathBuf},
+};
+
+use application::settings::diagnostics::{AppLogTail, DiagnosticsError};
+use async_trait::async_trait;
+
+/// The most bytes read from all log files together.
+const MAX_TAIL_BYTES: u64 = 512 * 1024;
+/// How many rotated files `logging::init` keeps.
+const ROTATED_FILES: u32 = 5;
+
+pub struct FileLogTail {
+    active: PathBuf,
+    max_bytes: u64,
+}
+
+impl FileLogTail {
+    pub fn new(logs_dir: &Path) -> Self {
+        Self::with_byte_budget(logs_dir, MAX_TAIL_BYTES)
+    }
+
+    pub fn with_byte_budget(logs_dir: &Path, max_bytes: u64) -> Self {
+        Self {
+            active: logs_dir.join("app.log"),
+            max_bytes,
+        }
+    }
+}
+
+#[async_trait]
+impl AppLogTail for FileLogTail {
+    async fn last_lines(&self, limit: usize) -> Result<Vec<String>, DiagnosticsError> {
+        let active = self.active.clone();
+        let budget = self.max_bytes;
+        tokio::task::spawn_blocking(move || read_tail(&active, limit, budget))
+            .await
+            .map_err(|_| DiagnosticsError::Unavailable)?
+    }
+}
+
+/// The newest `limit` lines over `app.log` and its rotations, reading at most `budget` bytes.
+/// An unreadable active file is an error; missing or unreadable rotations only shorten the tail.
+fn read_tail(active: &Path, limit: usize, budget: u64) -> Result<Vec<String>, DiagnosticsError> {
+    let mut remaining = budget;
+    let mut lines: Vec<String> = Vec::new();
+    for index in 0..=ROTATED_FILES {
+        let path = if index == 0 {
+            active.to_owned()
+        } else {
+            let mut name = active.as_os_str().to_owned();
+            name.push(format!(".{index}"));
+            PathBuf::from(name)
+        };
+        let window = match read_window(&path, remaining) {
+            Ok(window) => window,
+            Err(_) if index == 0 => return Err(DiagnosticsError::Unavailable),
+            Err(_) => break,
+        };
+        remaining -= window.bytes_read;
+        let mut older = window.lines;
+        older.append(&mut lines);
+        lines = older;
+        if lines.len() >= limit || remaining == 0 {
+            break;
+        }
+    }
+    let excess = lines.len().saturating_sub(limit);
+    lines.drain(..excess);
+    Ok(lines)
+}
+
+struct Window {
+    bytes_read: u64,
+    /// Whole lines only, oldest first.
+    lines: Vec<String>,
+}
+
+/// The last `max_bytes` of the file as whole lines: when the window starts inside a line, that
+/// partial line is dropped.
+fn read_window(path: &Path, max_bytes: u64) -> std::io::Result<Window> {
+    let mut file = File::open(path)?;
+    let length = file.metadata()?.len();
+    let take = length.min(max_bytes);
+    file.seek(SeekFrom::Start(length - take))?;
+    let mut bytes = Vec::with_capacity(usize::try_from(take).unwrap_or(0));
+    file.take(take).read_to_end(&mut bytes)?;
+    let mut text = &bytes[..];
+    if take < length {
+        match text.iter().position(|byte| *byte == b'\n') {
+            Some(newline) => text = &text[newline + 1..],
+            None => text = &[],
+        }
+    }
+    let text = String::from_utf8_lossy(text);
+    let mut lines: Vec<String> = text
+        .split('\n')
+        .map(|line| line.strip_suffix('\r').unwrap_or(line).to_owned())
+        .collect();
+    // The text after the final newline is empty, not a line.
+    if lines.last().is_some_and(String::is_empty) {
+        lines.pop();
+    }
+    Ok(Window {
+        bytes_read: take,
+        lines,
+    })
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/crates/infrastructure/src/shared/log_tail/tests.rs b/crates/infrastructure/src/shared/log_tail/tests.rs
new file mode 100644
index 0000000..27ac7c7
--- /dev/null
+++ b/crates/infrastructure/src/shared/log_tail/tests.rs
@@ -0,0 +1,88 @@
+use super::*;
+
+fn write(directory: &Path, name: &str, lines: impl IntoIterator<Item = String>) {
+    let mut text = String::new();
+    for line in lines {
+        text.push_str(&line);
+        text.push('\n');
+    }
+    std::fs::write(directory.join(name), text).unwrap();
+}
+
+fn numbered(range: std::ops::Range<usize>) -> impl Iterator<Item = String> {
+    range.map(|n| format!("line {n}"))
+}
+
+#[tokio::test]
+async fn diagnostics_caps_app_tail_by_lines_and_bytes() {
+    let directory = tempfile::tempdir().unwrap();
+
+    // By lines: only the newest 200 of 1000, in order.
+    write(directory.path(), "app.log", numbered(0..1000));
+    let lines = FileLogTail::new(directory.path())
+        .last_lines(200)
+        .await
+        .unwrap();
+    assert_eq!(lines.len(), 200);
+    assert_eq!(lines.first().unwrap(), "line 800");
+    assert_eq!(lines.last().unwrap(), "line 999");
+
+    // By bytes: 100 lines of 1 KiB against a 10 KiB budget yield the newest whole lines only.
+    let long = |n: usize| format!("{n:03}-{}", "x".repeat(1019));
+    write(directory.path(), "app.log", (0..100).map(long));
+    let lines = FileLogTail::with_byte_budget(directory.path(), 10 * 1024)
+        .last_lines(200)
+        .await
+        .unwrap();
+    assert!(!lines.is_empty() && lines.len() <= 10, "{}", lines.len());
+    assert!(lines.iter().map(|line| line.len() as u64 + 1).sum::<u64>() <= 10 * 1024);
+    assert!(lines.iter().all(|line| line.len() == 1023));
+    assert_eq!(lines.last().unwrap(), &long(99));
+
+    // A single line larger than the whole budget is never returned partially.
+    std::fs::write(directory.path().join("app.log"), "y".repeat(64 * 1024)).unwrap();
+    let lines = FileLogTail::with_byte_budget(directory.path(), 1024)
+        .last_lines(200)
+        .await
+        .unwrap();
+    assert!(lines.is_empty());
+}
+
+#[tokio::test]
+async fn rotated_files_fill_the_tail_in_chronological_order() {
+    let directory = tempfile::tempdir().unwrap();
+    write(directory.path(), "app.log.2", numbered(0..3));
+    write(directory.path(), "app.log.1", numbered(3..8));
+    write(directory.path(), "app.log", numbered(8..10));
+    let tail = FileLogTail::new(directory.path());
+
+    let lines = tail.last_lines(6).await.unwrap();
+    assert_eq!(
+        lines,
+        ["line 4", "line 5", "line 6", "line 7", "line 8", "line 9"]
+    );
+    let lines = tail.last_lines(200).await.unwrap();
+    assert_eq!(lines.len(), 10);
+    assert_eq!(lines.first().unwrap(), "line 0");
+}
+
+#[tokio::test]
+async fn unreadable_active_log_is_an_error_and_odd_bytes_are_tolerated() {
+    let directory = tempfile::tempdir().unwrap();
+    let tail = FileLogTail::new(directory.path());
+    assert_eq!(
+        tail.last_lines(10).await,
+        Err(DiagnosticsError::Unavailable)
+    );
+
+    std::fs::write(
+        directory.path().join("app.log"),
+        b"first\r\nbroken \xff\xfe bytes\r\nlast",
+    )
+    .unwrap();
+    let lines = tail.last_lines(10).await.unwrap();
+    assert_eq!(lines[0], "first");
+    assert!(lines[1].starts_with("broken ") && lines[1].ends_with(" bytes"));
+    assert_eq!(lines[2], "last");
+    assert!(tail.last_lines(0).await.unwrap().is_empty());
+}
