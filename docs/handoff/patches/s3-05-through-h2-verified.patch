+    assert_eq!(
+        progress.first().map(String::as_str),
+        Some("sink:Downloading { downloaded: 2, total: Some(100) }")
+    );
+    assert_eq!(
+        progress.last().map(String::as_str),
+        Some("sink:Downloading { downloaded: 100, total: Some(100) }")
