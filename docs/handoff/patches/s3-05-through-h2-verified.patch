+            let mut lease = gate.acquire().await.unwrap();
+            assert_eq!(lifecycle.before_start(&mut *lease).await, result);
             assert!(receiver.try_recv().is_err());
-            assert_eq!(lifecycle.after_stop(&mut Lease).await, result);
+            assert_eq!(lifecycle.after_stop(&mut *lease).await, result);
