+                    .snapshot(&root, &single, None, Default::default()),
+            );
+        drop(lease);
+        sender.send(result).unwrap();
+    });
+    assert_eq!(
+        receiver
+            .recv_timeout(Duration::from_secs(2))
+            .expect("FIFO read must return promptly")
+            .unwrap_err(),
+        NodeAppError::UnsafeSource
+    );
+    worker.join().unwrap();
+    assert!(gate.try_acquire().await.is_ok());
+}
