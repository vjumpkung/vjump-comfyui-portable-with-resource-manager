+            | "api_key"
+            | "signature"
+            | "sig"
+            | "key-pair-id"
+            | "policy"
+            | "awsaccesskeyid"
+            | "googleaccessid"
+    ) || key.starts_with("x-amz-")
+        || key.starts_with("x-goog-")
+        || key.starts_with("x-oss-")
+}
