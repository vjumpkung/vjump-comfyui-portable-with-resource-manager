+    let released = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let retained = Retained::new(Arc::new(DropFlag(released.clone())));
+    let spec = shell(script)
+        .stdin(Arc::from(
+            &b"alpha
+beta
+"[..],
