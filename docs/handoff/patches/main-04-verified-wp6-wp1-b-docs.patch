+async fn tunnel(relay: &HfRelay) -> TcpStream {
+    let mut child = TcpStream::connect(relay.address).await.unwrap();
+    child
+        .write_all(b"CONNECT huggingface.co:443 HTTP/1.1\r\nHost: huggingface.co:443\r\n\r\n")
+        .await
+        .unwrap();
+    assert!(
