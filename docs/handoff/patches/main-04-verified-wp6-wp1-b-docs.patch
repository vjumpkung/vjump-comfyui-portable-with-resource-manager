+#[cfg(windows)]
+fn assert_sharing_refusal(error: &std::io::Error) {
+    // ERROR_ACCESS_DENIED / ERROR_SHARING_VIOLATION: the pin, not a missing privilege.
+    assert!(
+        matches!(error.raw_os_error(), Some(5 | 32)),
+        "unexpected substitution error: {error}"
+    );
+}
