+fn start_checks_node_recovery_under_the_maintenance_lease() {
+    let m = Machine::new();
+    m.node_journal_failure.store(true, Ordering::SeqCst);
+    assert_eq!(
+        block_on(StartComfy::new(m.deps()).execute()),
