+
+    // The unpublished release commit is neither attached nor lost.
+    install.switch("v1.0.1", &patch).await;
+    assert_eq!(install.head(), "HEAD");
+    assert_eq!(git(&install.comfy, &["rev-parse", "HEAD"]), patch);
