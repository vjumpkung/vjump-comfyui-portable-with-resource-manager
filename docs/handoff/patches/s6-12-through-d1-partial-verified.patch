+      'D:\\Models',
+    ),
+  )
+  expect(await screen.findByText('D:\\Models\\checkpoints')).toBeTruthy()
+  expect(gateway.comfyReadExtraModelPaths).toHaveBeenCalledTimes(2)
+})
+
+it('remove_is_offered_only_for_the_app_section', async () => {
