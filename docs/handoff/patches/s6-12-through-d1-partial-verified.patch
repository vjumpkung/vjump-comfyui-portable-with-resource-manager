+                .map_err(|_| RuntimeError::InvalidRecord),
+            (false, None, Some(branch)) => {
+                Tag::new(branch.clone()).map_err(|_| RuntimeError::InvalidRecord)?;
+                Ok(UpdateTarget::LatestCommit)
+            }
+            _ => Err(RuntimeError::InvalidRecord),
+        }
+    }
+}
