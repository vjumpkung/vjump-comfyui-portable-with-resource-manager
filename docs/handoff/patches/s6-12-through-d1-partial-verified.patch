+#[tauri::command]
+#[specta::specta]
+pub async fn comfy_generate_extra_model_paths(
+    state: State<'_, AppState>,
+    base_path: String,
+) -> Result<(), IpcError> {
+    let services = state.services()?;
+    services
+        .comfy
+        .manage_extra_paths
+        .generate(Path::new(&base_path))
+        .await?;
+    rescan_library(services).await;
+    Ok(())
