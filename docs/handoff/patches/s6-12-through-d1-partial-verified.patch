+impl FrozenUpdate {
+    pub fn policy_target(&self) -> Result<UpdateTarget, RuntimeError> {
+        match (self.fast_forward, &self.tag, &self.branch) {
+            (true, None, None) => Ok(UpdateTarget::BranchFfOnly),
+            (false, Some(tag), None) => Tag::new(tag.clone())
