+    if cfg!(windows) {
+        cases.push((fx.root.join("ENVS").join("x"), INSIDE_APP));
+        cases.push((fx.root.join("COMFYUI").join("models"), INSIDE_APP));
+    }
+    for (base, message) in cases {
+        assert_eq!(
+            rejection(generate(&fx.root, &base)),
+            message,
+            "{}",
