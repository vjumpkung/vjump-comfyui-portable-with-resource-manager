+        pins.insert(DistName::new("torch").unwrap(), "2.14.1+cu130");
+        pins.insert(DistName::new("torchvision").unwrap(), "0.29.1+cu130");
+        pins.insert(DistName::new("triton-windows").unwrap(), "3.8.0.post29");
