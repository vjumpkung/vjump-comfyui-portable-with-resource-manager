+            if let Err(error) = publication.cleanup_committed() {
+                ctx.log(format!(
+                    "Warning: the checkout was published, but staging cleanup failed: {error}"
+                ));
+            }
+            return Ok(true);
+        }
+        self.verify_rollback(publication, &record, layout, ctx)
+            .await?;
+        Ok(false)
+    }
+
+    pub(super) async fn publish_scaffold(
