+            commit: resolved.commit.clone()
+        }
+    );
+    let offline = ResolvedGit {
+        url: "does-not-exist".into(),
+        ..resolved
+    };
+    source
+        .clone_comfyui(&fixture.root, &offline, &ctx())
+        .await
+        .unwrap();
+    assert_no_publication(&fixture.root);
+}
