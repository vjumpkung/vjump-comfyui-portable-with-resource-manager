+        layout: &Layout,
+        ctx: &StepContext,
+    ) -> Result<bool, ProvisionError> {
+        let Some(record) = publication.load().map_err(|_| failed(INTERRUPTED))? else {
+            return Ok(false);
+        };
+        if publication
+            .committed(&record)
+            .map_err(|_| failed(INTERRUPTED))?
