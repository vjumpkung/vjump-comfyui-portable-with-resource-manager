<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="ddd-bounded-contexts" name="DDD bounded contexts">
    <mxGraphModel dx="1880" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1560" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Domain-driven design&lt;/b&gt; — bounded contexts and context map" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1840" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Each bounded context is one module name in every crate (domain → application → infrastructure → desktop IPC) plus one UI feature, per ADR-0002. Arrows show selected runtime dependencies across contexts. There is no event bus: cross-context calls go through injected ports and are awaited; the one fire-and-forget call is NodeLifecycle::request_scan (Stop, Restart and Update queue a background node scan and return at once). Construction and wiring: dependency-injection.drawio." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1840" height="56" as="geometry"/></mxCell>
        <mxCell id="env" value="Environment" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="360" height="536" as="geometry"/></mxCell>
        <mxCell id="env_lives" value="*::environment · ipc/env_commands.rs · ui: setup/, environment/" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="env"><mxGeometry x="10" y="42" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="env_dom" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;&lt;b&gt;Aggregate&lt;/b&gt; PythonEnvironment — EnvId, Ownership, EnvState: Provisioning → Verified | Failed · Verified ⇄ RepairRequired · Failed → Provisioning&lt;br&gt;&lt;b&gt;Value objects&lt;/b&gt; SetupProfile, TorchBuild, AcceleratorSpec, PinSet / DistName, HardwareObservation, PythonVersion, CudaVersion, ComputeCapability&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt; eligibility::evaluate(), check_activation(), check_deletable()" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="env"><mxGeometry x="10" y="86" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="env_uc" value="&lt;b&gt;Use cases&lt;/b&gt;&lt;br&gt;StartSetup, ExecuteSetup, CancelSetup, DetectHardware, ListProfiles, ValidatePython, SelectInstallRoot, PreviewPackageChange, ApplyPackageChange, DeleteEnvironment, ReconcileStartup, GetEnvironmentInfo, GetSetupStatus, ListPackages" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="env"><mxGeometry x="10" y="234" width="340" height="122" as="geometry"/></mxCell>
        <mxCell id="env_ports" value="&lt;b&gt;Ports → adapters&lt;/b&gt;&lt;br&gt;EnvironmentRepository → SqliteEnvironmentStore&lt;br&gt;HardwareProbe → SystemHardware (NVML)&lt;br&gt;PythonProvisioner, PackageInstaller → PythonAdapter, UvPackages&lt;br&gt;ComfySource → GitSource · ProfileCatalog → BundledProfiles&lt;br&gt;RuntimeMaintenance → ComfyRuntimeSupervisor (relocation: RelocationRuntimeGuard)&lt;br&gt;EnvironmentUsers → ProcessEnvironmentUsers (refuses env changes while an outside program runs from it) · RootSwitcher → FsRootSwitcher (also held by gallery, settings)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="env"><mxGeometry x="10" y="364" width="340" height="162" as="geometry"/></mxCell>
        <mxCell id="nodes" value="Custom Nodes" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="360" height="536" as="geometry"/></mxCell>
        <mxCell id="nodes_lives" value="*::custom_nodes · ipc/node_commands.rs · ui: custom-nodes/" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="nodes"><mxGeometry x="10" y="42" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="nodes_dom" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;&lt;b&gt;Aggregate&lt;/b&gt; InstalledNode — NodeId, NodeSource: Registry | Git | Manual, DependencyState: NotRun | Ok | Failed, ProvenanceOrigin&lt;br&gt;&lt;b&gt;Policies&lt;/b&gt; InstallConsent.check(), Compatibility (OS and accelerator support, warnings)&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt; is_comfyui_shipped(): files ComfyUI ships in custom_nodes/ are not nodes" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;" vertex="1" parent="nodes"><mxGeometry x="10" y="86" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="nodes_uc" value="&lt;b&gt;Use cases&lt;/b&gt;&lt;br&gt;NodeService: prepare (registry · git · update · retry deps) → review → commit; set enabled / uninstall run directly (no review); update all, cancel (node_cancel), close interrupted operation (resolve_operation), background inventory scan (rescan_when_free under the node lock; node operations and setup cancel a running scan through ScanControl) · LocateNode" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;" vertex="1" parent="nodes"><mxGeometry x="10" y="234" width="340" height="122" as="geometry"/></mxCell>
        <mxCell id="nodes_ports" value="&lt;b&gt;Ports → adapters&lt;/b&gt;&lt;br&gt;RegistryClient → RegistryHttp (api.comfy.org)&lt;br&gt;NodeRepository → SqliteNodes (operations + Git evidence, atomic apply_scan)&lt;br&gt;NodeFiles → LocalNodeFiles (cancellable scan, publish/recover digests)&lt;br&gt;NodeLocationGuard → PinnedLocation · NodeHook → PythonHook&lt;br&gt;node_lock: a second MaintenanceGate instance, shared by node operations, setup and scans" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;" vertex="1" parent="nodes"><mxGeometry x="10" y="364" width="340" height="162" as="geometry"/></mxCell>
        <mxCell id="runtime" value="ComfyUI Runtime" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1500" y="170" width="360" height="536" as="geometry"/></mxCell>
        <mxCell id="runtime_lives" value="*::comfy_runtime · ipc/comfy_commands.rs · ui: comfy-runtime/" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="runtime"><mxGeometry x="10" y="42" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="runtime_dom" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;&lt;b&gt;State machine&lt;/b&gt; Lifecycle: Stopped → Starting → Running → Stopping | Crashed, guarded by transition(); RuntimeFailure&lt;br&gt;&lt;b&gt;Value objects&lt;/b&gt; LaunchOptions (Port, VramMode, Attention, PreviewMethod), UpdateTarget, Tag, Revision, RepoState&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt; LaunchOptions.validate(), can_update(), checkout_placement()" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="runtime"><mxGeometry x="10" y="86" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="runtime_uc" value="&lt;b&gt;Use cases&lt;/b&gt;&lt;br&gt;StartComfy, StopComfy, RestartComfy, GetComfyStatus, GetLaunchOptions, SetLaunchOptions, ListComfyVersions, UpdateComfy, ReadExtraModelPaths, ManageExtraModelPaths" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="runtime"><mxGeometry x="10" y="234" width="340" height="122" as="geometry"/></mxCell>
        <mxCell id="runtime_ports" value="&lt;b&gt;Ports → adapters&lt;/b&gt;&lt;br&gt;RuntimeSupervisor + RuntimeMaintenance (for environment, nodes, app update) → ComfyRuntimeSupervisor (process)&lt;br&gt;RuntimeEvents, RuntimeLogReader → RuntimeLogHub&lt;br&gt;ComfyRepository → GitRepository · PortProbe → TcpPortProbe&lt;br&gt;ExtraModelPaths(Writer) → YamlExtraModelPaths&lt;br&gt;RuntimeStore → SqliteRuntimeStore · LaunchPreflight → PythonLaunchPreflight" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="runtime"><mxGeometry x="10" y="364" width="340" height="162" as="geometry"/></mxCell>
        <mxCell id="settings" value="Settings (credentials · diagnostics · updates)" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="784" width="360" height="514" as="geometry"/></mxCell>
        <mxCell id="settings_lives" value="*::settings · ipc/commands.rs, app_commands.rs · ui: settings/" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="settings"><mxGeometry x="10" y="42" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="settings_dom" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;&lt;b&gt;Entity&lt;/b&gt; Settings (incl. skip_security_confirmations)&lt;br&gt;&lt;b&gt;Value objects&lt;/b&gt; Concurrency, TtlHours, HfEngine, CloseBehavior, Theme, Language, CredentialKind" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="settings"><mxGeometry x="10" y="86" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="settings_uc" value="&lt;b&gt;Use cases&lt;/b&gt;&lt;br&gt;GetSettings, UpdateSettings, SetCredential, ClearCredential, GetCredentialStatus, TestCredential, CollectDiagnostics, InstallAppUpdate" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="settings"><mxGeometry x="10" y="234" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="settings_ports" value="&lt;b&gt;Ports → adapters&lt;/b&gt;&lt;br&gt;SettingsRepository → SqliteSettingsRepository&lt;br&gt;CredentialStore → KeyringCredentialStore&lt;br&gt;CredentialTester → ProviderCredentialTester&lt;br&gt;AppLogTail → FileLogTail · AppUpdater → SignedUpdater (desktop)&lt;br&gt;CollectDiagnostics holds its own RuntimeDeps over the same runtime adapters · InstallAppUpdate takes gate, RuntimeMaintenance and RootSwitcher from EnvironmentDeps; the AppUpdater is passed per call" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="settings"><mxGeometry x="10" y="342" width="340" height="162" as="geometry"/></mxCell>
        <mxCell id="acq" value="Models › Acquisition (downloads)" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="513" y="784" width="360" height="514" as="geometry"/></mxCell>
        <mxCell id="acq_lives" value="*::models::acquisition · ipc/download_commands.rs · ui: downloads/" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="acq"><mxGeometry x="10" y="42" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="acq_dom" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;&lt;b&gt;Aggregate&lt;/b&gt; DownloadJob — DownloadState: Queued → Resolving → Downloading → Verifying → Completed (or Paused | Failed | Cancelled), PublicationIntent, StopIntent&lt;br&gt;&lt;b&gt;Value objects&lt;/b&gt; SourceRef: CivitAi | HuggingFace | GoogleDrive | Direct, Destination, FileIdentity&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt; retry_action(code, retries, refreshed)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="acq"><mxGeometry x="10" y="86" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="acq_uc" value="&lt;b&gt;Use cases&lt;/b&gt;&lt;br&gt;ResolveDownload, EnqueueDownloads, PauseJob, ResumeJob, CancelJob, RetryJob, RemoveJob, FinalizeDownload, ImportPack, ExportResourceList, ListJobs, ReconcileOnStartup" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="acq"><mxGeometry x="10" y="234" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="acq_ports" value="&lt;b&gt;Ports → adapters&lt;/b&gt;&lt;br&gt;SourceResolver → ProviderResolver&lt;br&gt;Downloader → Native, Hf, Gdown downloaders&lt;br&gt;JobRepository → SqliteDownloads&lt;br&gt;DownloadFiles → LocalDownloadFiles&lt;br&gt;ProgressSink, DownloadEvents → DownloadHub&lt;br&gt;DownloadControl → DownloadSupervisor · ModelPacks → ResourcePacks · ProviderCredentialTester implements Settings' CredentialTester" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="acq"><mxGeometry x="10" y="342" width="340" height="162" as="geometry"/></mxCell>
        <mxCell id="lib" value="Models › Library" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1006" y="784" width="360" height="514" as="geometry"/></mxCell>
        <mxCell id="lib_lives" value="*::models::library · ipc/library_commands.rs · ui: library/" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="lib"><mxGeometry x="10" y="42" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="lib_dom" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;&lt;b&gt;Entity&lt;/b&gt; ModelFile — ModelLocation (root + RelativeModelPath), ModelCategory, SidecarSet&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt; validate_rename(), sidecar naming (stem_of, renamed_sidecar), ambiguous-stem detection, ModelCategory::suggest_civitai()" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="lib"><mxGeometry x="10" y="86" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="lib_uc" value="&lt;b&gt;Use cases&lt;/b&gt;&lt;br&gt;ListModels, RescanModels, GetModelDetails, RenameModel, MoveModel, PlanDelete, DeleteModels, DeleteModelsPermanently, IdentifyModel, ReconcileModelOperations, GetLibraryStatus, GetOperationStatus, LocateModel" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="lib"><mxGeometry x="10" y="234" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="lib_ports" value="&lt;b&gt;Ports → adapters&lt;/b&gt;&lt;br&gt;ModelCatalog → SqliteCatalog&lt;br&gt;ModelFiles → LocalModelFiles (+ OS trash, guards ComfyUI Git-tracked paths)&lt;br&gt;OperationJournal → SqliteJournal&lt;br&gt;CivitaiLookup → CivitaiClient&lt;br&gt;ModelDetailsReader → SidecarDetails&lt;br&gt;LibraryControl → LibrarySupervisor (watcher + scan loop)&lt;br&gt;PathLocks (shared with downloads; SqliteDownloads supplies DestinationReservations) · ExtraModelPaths (runtime) · Civitai token via the keyring vault" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="lib"><mxGeometry x="10" y="342" width="340" height="162" as="geometry"/></mxCell>
        <mxCell id="gal" value="Gallery (input / output)" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1500" y="784" width="360" height="514" as="geometry"/></mxCell>
        <mxCell id="gal_lives" value="*::gallery · ipc/gallery_commands.rs · gallery_protocol.rs · ui: gallery/" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="gal"><mxGeometry x="10" y="42" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="gal_dom" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;&lt;b&gt;Value objects&lt;/b&gt; GalleryLocation (GalleryArea: Input | Output + RelativeModelPath; parent, join, contains), GalleryEntryKind, GalleryMediaKind: Image | Video | Audio | Model3d | Other&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt; classify_media(name)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="gal"><mxGeometry x="10" y="86" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="gal_uc" value="&lt;b&gt;Use cases&lt;/b&gt;&lt;br&gt;ListGallery, RenameGalleryEntry, TransferGalleryEntries (move / copy), PlanGalleryDelete, DeleteGalleryEntries, OpenGalleryMedia (gallery://), LocateGalleryEntry" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="gal"><mxGeometry x="10" y="234" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="gal_ports" value="&lt;b&gt;Ports → adapters&lt;/b&gt;&lt;br&gt;GalleryFiles → LocalGalleryFiles (hides and guards ComfyUI Git-tracked paths)&lt;br&gt;GalleryMedia → LocalMedia&lt;br&gt;RootSwitcher (environment) · MaintenanceGate (mutations)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="gal"><mxGeometry x="10" y="342" width="340" height="162" as="geometry"/></mxCell>
        <mxCell id="sk" value="Shared kernel — used by every context" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="1338" width="1840" height="144" as="geometry"/></mxCell>
        <mxCell id="sk_dom" value="&lt;b&gt;domain::shared::model_values&lt;/b&gt;&lt;br&gt;SafeFileName · RelativeModelPath · Sha256 · JobId — validated value types reused by library, acquisition, gallery, custom nodes and environment" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="sk"><mxGeometry x="20" y="42" width="890" height="90" as="geometry"/></mxCell>
        <mxCell id="sk_app" value="&lt;b&gt;application::shared&lt;/b&gt; — MaintenanceGate + MaintenanceLease (acquire · try_acquire · acquire_within): one gate serialises environment, node, ComfyUI start / stop / restart / update, gallery-mutation, app-update, app-exit and root-recovery operations; a second instance, the node lock, is shared by node operations, setup and scans (WithNodeLock holds both, gate first; scans only try the gate briefly) · PathLocks / ModelPathLocks · DestinationReservations · Clock · IdGenerator · CancelToken · Retained · ExplorerTarget" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="sk"><mxGeometry x="930" y="42" width="890" height="90" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;: card colour = the matching UI feature colour on the communication diagram · arrow A → B = A uses B at runtime (the label names the port or type) · ports are application traits, implemented in infrastructure, application services, or desktop (e.g. AppUpdater) · ui overview/ is a read-only dashboard across contexts&lt;br&gt;&lt;b&gt;ADR-0002 rules&lt;/b&gt;: no serde in domain or application · errors translated at every boundary · no CQRS or event sourcing · channels only notify the UI" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#fafafa;strokeColor=#999999;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="1502" width="1840" height="56" as="geometry"/></mxCell>
