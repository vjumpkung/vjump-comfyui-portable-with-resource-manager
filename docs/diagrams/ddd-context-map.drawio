<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="ddd-bounded-contexts" name="DDD bounded contexts">
    <mxGraphModel dx="1880" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1400" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Domain-driven design&lt;/b&gt; — bounded contexts and context map" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1840" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Each bounded context is one module name in every crate (domain → application → infrastructure → desktop IPC) plus one UI feature, per ADR-0002. Arrows show runtime use across contexts; there is no event bus, so cross-context effects are awaited calls." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1840" height="40" as="geometry"/></mxCell>
        <mxCell id="env" value="Environment" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="360" height="472" as="geometry"/></mxCell>
        <mxCell id="env_lives" value="*::environment · ipc/env_commands.rs · ui: setup/, environment/" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="env"><mxGeometry x="10" y="42" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="env_dom" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;&lt;b&gt;Aggregate&lt;/b&gt; PythonEnvironment — EnvId, Ownership, EnvState: Provisioning → Verified | Failed | RepairRequired&lt;br&gt;&lt;b&gt;Value objects&lt;/b&gt; SetupProfile, TorchBuild, AcceleratorSpec, PinSet / DistName, HardwareObservation, PythonVersion, CudaVersion, ComputeCapability&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt; eligibility::evaluate(), check_activation(), check_deletable()" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="env"><mxGeometry x="10" y="86" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="env_uc" value="&lt;b&gt;Use cases&lt;/b&gt;&lt;br&gt;StartSetup, ExecuteSetup, CancelSetup, DetectHardware, ListProfiles, ValidatePython, SelectInstallRoot, PreviewPackageChange, ApplyPackageChange, DeleteEnvironment, ReconcileStartup, GetEnvironmentInfo" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="env"><mxGeometry x="10" y="234" width="340" height="100" as="geometry"/></mxCell>
