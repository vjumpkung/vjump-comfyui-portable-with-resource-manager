        <mxCell id="sk" value="Shared kernel — used by every context" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="1202" width="1840" height="120" as="geometry"/></mxCell>
        <mxCell id="sk_dom" value="&lt;b&gt;domain::shared::model_values&lt;/b&gt;&lt;br&gt;SafeFileName · RelativeModelPath · Sha256 · JobId — validated value types reused by library, acquisition, gallery, custom nodes and environment" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="sk"><mxGeometry x="20" y="42" width="890" height="66" as="geometry"/></mxCell>
        <mxCell id="sk_app" value="&lt;b&gt;application::shared&lt;/b&gt;&lt;br&gt;MaintenanceGate + MaintenanceLease: one gate serialises environment, node, ComfyUI update and start operations · PathLocks / ModelPathLocks · DestinationReservations · Clock · IdGenerator · cancellation" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="sk"><mxGeometry x="930" y="42" width="890" height="66" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;: card colour = the matching UI feature colour on the communication diagram · arrow A → B = A uses B at runtime (the label names the port or type) · ports are traits in application, implemented by infrastructure adapters · ui overview/ is a read-only dashboard across contexts&lt;br&gt;&lt;b&gt;ADR-0002 rules&lt;/b&gt;: no serde in domain or application · errors translated at every boundary · no CQRS or event sourcing · channels only notify the UI" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#fafafa;strokeColor=#999999;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="1342" width="1840" height="56" as="geometry"/></mxCell>
        <mxCell id="c_env_nodes" value="&lt;b&gt;SetupNodes&lt;/b&gt; port&lt;br&gt;installs curated nodes during setup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.339;exitDx=0;exitDy=0;entryX=0;entryY=0.339;entryDx=0;entryDy=0;" edge="1" parent="1" source="env" target="nodes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c_nodes_env" value="&lt;b&gt;NodeRequirementSource&lt;/b&gt; · PackageInstaller&lt;br&gt;installs node requirements into the env" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.6992;exitDx=0;exitDy=0;entryX=1;entryY=0.6992;entryDx=0;entryDy=0;" edge="1" parent="1" source="nodes" target="env"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c_rt_nodes" value="&lt;b&gt;NodeLifecycle&lt;/b&gt; port&lt;br&gt;before_start / after_stop hooks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.339;exitDx=0;exitDy=0;entryX=1;entryY=0.339;entryDx=0;entryDy=0;" edge="1" parent="1" source="runtime" target="nodes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
