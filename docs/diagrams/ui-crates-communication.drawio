<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="ui-and-crates-communication" name="UI and crates communication">
    <mxGraphModel dx="1800" dy="1530" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1530" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;vjumpkung ComfyUI Desktop&lt;/b&gt; — how the UI and the Rust crates communicate" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1700" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Tauri 2 desktop app · React + TypeScript UI · Rust workspace layered as domain ← application ← infrastructure ← desktop (ADR-0002)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1700" height="24" as="geometry"/></mxCell>
        <mxCell id="ui" value="ui/ — React 19 + TypeScript (Vite) · manager window" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#e6f0ff;strokeColor=#4a6fa5;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1210" height="360" as="geometry"/></mxCell>
        <mxCell id="ui_app" value="&lt;b&gt;app/&lt;/b&gt; — main.tsx · App.tsx (QueryClientProvider, setup-wizard gate) · shell: sidebar, top bar, nav, theme toggle" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#4a6fa5;strokeWidth=1;" vertex="1" parent="ui"><mxGeometry x="20" y="44" width="1170" height="40" as="geometry"/></mxCell>
        <mxCell id="ui_feat" value="features/ — one folder per bounded context · ESLint boundaries: a feature imports only shared/, never another feature" style="swimlane;startSize=26;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=12;align=left;spacingLeft=12;collapsible=0;fillColor=#f7f7f7;strokeColor=#999999;swimlaneFillColor=#ffffff;" vertex="1" parent="ui"><mxGeometry x="20" y="96" width="1170" height="108" as="geometry"/></mxCell>
        <mxCell id="f_overview" value="overview" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="ui_feat"><mxGeometry x="10.0" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="f_comfy-runtime" value="comfy-runtime" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ui_feat"><mxGeometry x="138.75" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="f_downloads" value="downloads" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ui_feat"><mxGeometry x="267.5" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="f_library" value="library" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ui_feat"><mxGeometry x="396.25" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="f_custom-nodes" value="custom-nodes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ui_feat"><mxGeometry x="525.0" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="f_gallery" value="gallery" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="ui_feat"><mxGeometry x="653.75" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="f_environment" value="environment" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ui_feat"><mxGeometry x="782.5" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="f_setup" value="setup" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ui_feat"><mxGeometry x="911.25" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="f_settings" value="settings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="ui_feat"><mxGeometry x="1040.0" y="36" width="120" height="58" as="geometry"/></mxCell>
        <mxCell id="ui_shared" value="&lt;b&gt;shared/&lt;/b&gt;&lt;br&gt;ui — reusable components&lt;br&gt;lib — helpers&lt;br&gt;i18n — en, th&lt;br&gt;testing — test utilities" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#4a6fa5;strokeWidth=1;" vertex="1" parent="ui"><mxGeometry x="20" y="230" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="ui_state" value="&lt;b&gt;Client state&lt;/b&gt;&lt;br&gt;• request/response data: TanStack Query hooks (queries.ts, use-*.ts)&lt;br&gt;• live data: per-feature stores (runtime-, downloads-, library-store.ts) fed by Channel events and read with useSyncExternalStore" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#4a6fa5;strokeWidth=1;" vertex="1" parent="ui"><mxGeometry x="340" y="230" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;shared/ipc/gateway.ts&lt;/b&gt; — the only door to Tauri&lt;br&gt;• wraps the generated &lt;b&gt;bindings.ts&lt;/b&gt; (tauri-specta)&lt;br&gt;• unwraps Result → throws IpcClientError(code, message)&lt;br&gt;• opens a Channel for each subscription and for setup / app-update progress&lt;br&gt;• builds gallery:// preview URLs" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="ui"><mxGeometry x="760" y="230" width="430" height="110" as="geometry"/></mxCell>
        <mxCell id="cw" value="ComfyUI window — separate webview" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="1260" y="80" width="460" height="360" as="geometry"/></mxCell>
        <mxCell id="cw_ui" value="&lt;b&gt;ComfyUI web UI&lt;/b&gt; (webview label: comfyui)&lt;br&gt;• loads http://127.0.0.1:&amp;lt;port&amp;gt; served by the ComfyUI Python process&lt;br&gt;• opened by desktop comfy_window.rs&lt;br&gt;• no capability names this window, so it can never invoke app commands or read gallery://&lt;br&gt;• Windows: comfy_window/save_as.rs handles WebView2 downloads with native Save As (Rust; no app IPC capability added)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="cw"><mxGeometry x="20" y="50" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="ipc" value="Tauri 2 IPC boundary (webview ⇄ Rust core)" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#fff4e0;strokeColor=#e08e0b;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1700" height="140" as="geometry"/></mxCell>
        <mxCell id="invoke" value="&lt;b&gt;① invoke — request / response&lt;/b&gt;&lt;br&gt;94 async #[tauri::command]s, typed end to end by tauri-specta · returns Result&amp;lt;Dto, IpcError&amp;gt; · allowed only by the capabilities/manager.json ACL" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#e08e0b;strokeWidth=1;" vertex="1" parent="ipc"><mxGeometry x="20" y="44" width="530" height="82" as="geometry"/></mxCell>
        <mxCell id="channel" value="&lt;b&gt;② Channel&amp;lt;EventDto&amp;gt; — streaming&lt;/b&gt;&lt;br&gt;setup, ComfyUI lifecycle/logs, downloads, model/node events, app updates · subscriptions start with snapshots (nodes: marker) · ComfyUI: log replay · downloads: cursor gap checks · unsubscribe does not cancel work" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#e08e0b;strokeWidth=1;" vertex="1" parent="ipc"><mxGeometry x="585" y="44" width="530" height="82" as="geometry"/></mxCell>
        <mxCell id="gallery" value="&lt;b&gt;③ gallery:// URI scheme — media&lt;/b&gt;&lt;br&gt;read-only input/output files for &amp;lt;img&amp;gt;, &amp;lt;video&amp;gt; and the 3D viewer · manager window only · path-free errors" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#e08e0b;strokeWidth=1;" vertex="1" parent="ipc"><mxGeometry x="1150" y="44" width="530" height="82" as="geometry"/></mxCell>
        <mxCell id="desk" value="crates/desktop — composition root and IPC adapters" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#ede7f6;strokeColor=#5e35b1;swimlaneFillColor=#ffffff;align=right;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="1700" height="230" as="geometry"/></mxCell>
        <mxCell id="bindings" value="&lt;b&gt;ipc/bindings.rs&lt;/b&gt;&lt;br&gt;tauri-specta Builder: one command list → invoke handler, generated bindings.ts, ACL tests" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="desk"><mxGeometry x="20" y="44" width="310" height="76" as="geometry"/></mxCell>
        <mxCell id="commands" value="&lt;b&gt;ipc/commands.rs + *_commands.rs&lt;/b&gt; — thin controllers&lt;br&gt;App info, settings, secrets · env · comfy · download · library · node · gallery · app (updates, diagnostics)&lt;br&gt;Calls application use cases and NodeService" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="desk"><mxGeometry x="380" y="44" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="bridges" value="&lt;b&gt;Event bridges&lt;/b&gt;&lt;br&gt;Channel-backed sinks and hub subscriptions turn application events into EventDto messages" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="desk"><mxGeometry x="830" y="44" width="330" height="76" as="geometry"/></mxCell>
        <mxCell id="gproto" value="&lt;b&gt;gallery_protocol.rs&lt;/b&gt;&lt;br&gt;checks the requesting webview is the manager, reads through the pinned, non-following gallery adapter, serves HTTP Range" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="desk"><mxGeometry x="1210" y="44" width="470" height="76" as="geometry"/></mxCell>
        <mxCell id="tadapters" value="&lt;b&gt;Tauri-side adapters&lt;/b&gt;: comfy_window.rs (ComfyUI window + Windows Save As for its downloads) · app_lifecycle.rs (close coordinator, explorer) · updates.rs (signed updater) · picker.rs (dialogs) · diagnostics.rs (clipboard)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="desk"><mxGeometry x="20" y="136" width="540" height="76" as="geometry"/></mxCell>
        <mxCell id="dto" value="&lt;b&gt;ipc/dto.rs, *_dto.rs + error.rs&lt;/b&gt;&lt;br&gt;IPC DTOs use serde / specta here · into_domain() validates input · errors are sanitized to IpcError { code, message }" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="desk"><mxGeometry x="620" y="136" width="440" height="76" as="geometry"/></mxCell>
        <mxCell id="state" value="&lt;b&gt;state.rs — AppState::compose()&lt;/b&gt; = composition root&lt;br&gt;builds infrastructure adapters, injects them as Arc&amp;lt;dyn Port&amp;gt; into use cases, groups them as Services per context; recovery mode when the install root cannot open" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#f3eefc;strokeColor=#5e35b1;strokeWidth=2;" vertex="1" parent="desk"><mxGeometry x="1100" y="136" width="580" height="76" as="geometry"/></mxCell>
        <mxCell id="app" value="crates/application — use cases + ports (no serde, no IO)" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#e0f2f1;strokeColor=#00897b;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="920" width="1020" height="210" as="geometry"/></mxCell>
        <mxCell id="usecases" value="&lt;b&gt;Use cases&lt;/b&gt; — execute(...) structs and NodeService methods&lt;br&gt;• environment: StartSetup, ExecuteSetup, ApplyPackageChange, DeleteEnvironment…&lt;br&gt;• comfy_runtime: StartComfy, StopComfy, UpdateComfy, SetLaunchOptions…&lt;br&gt;• models::acquisition: EnqueueDownloads, FinalizeDownload, ImportPack…&lt;br&gt;• models::library: RescanModels, RenameModel, MoveModel, IdentifyModel…&lt;br&gt;• custom_nodes: NodeService (prepare, commit, update_all, resolve_operation…)&lt;br&gt;• gallery: ListGallery, TransferGalleryEntries…&lt;br&gt;• settings: UpdateSettings, SetCredential, CollectDiagnostics, InstallAppUpdate" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#00897b;strokeWidth=1;" vertex="1" parent="app"><mxGeometry x="20" y="44" width="600" height="150" as="geometry"/></mxCell>
        <mxCell id="ports" value="&lt;b&gt;Port traits&lt;/b&gt; — injected as Arc&amp;lt;dyn Port + Send + Sync&amp;gt; (async-trait)&lt;br&gt;repositories · providers · processes · filesystem · trash · secrets · clock · GPU probe · ProgressSink / *Events for streaming" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#00897b;strokeWidth=1;" vertex="1" parent="app"><mxGeometry x="680" y="44" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="appshared" value="&lt;b&gt;shared&lt;/b&gt;: MaintenanceGate · PathLocks · Clock · IdGenerator · cancel" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#00897b;strokeWidth=1;" vertex="1" parent="app"><mxGeometry x="680" y="150" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="dom" value="crates/domain — entities, value objects, invariants" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#fce4ec;strokeColor=#ad1457;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="1170" width="1020" height="120" as="geometry"/></mxCell>
        <mxCell id="domain_body" value="environment · comfy_runtime · models::{acquisition, library} · custom_nodes · gallery · settings · shared (SafeFileName, RelativeModelPath, Sha256, JobId)&lt;br&gt;Aggregates, value objects, state machines and rules · no Tauri, network, DB or GPU, so it is fully unit-testable (coverage gate ≥ 90 %)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#ad1457;strokeWidth=1;" vertex="1" parent="dom"><mxGeometry x="20" y="44" width="980" height="62" as="geometry"/></mxCell>
        <mxCell id="infra" value="crates/infrastructure — adapters that implement the ports" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#eceff1;strokeColor=#455a64;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1080" y="920" width="640" height="370" as="geometry"/></mxCell>
        <mxCell id="inf0" value="&lt;b&gt;Persistence&lt;/b&gt;&lt;br&gt;rusqlite repositories (SqliteEnvironmentStore, SqliteCatalog, SqliteDownloads…) + 10 SQL migrations" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=1;" vertex="1" parent="infra"><mxGeometry x="20" y="44" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="inf1" value="&lt;b&gt;Secrets&lt;/b&gt;&lt;br&gt;KeyringCredentialStore — tokens never go into SQLite, URLs or logs" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=1;" vertex="1" parent="infra"><mxGeometry x="330" y="44" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="inf2" value="&lt;b&gt;ComfyUI runtime&lt;/b&gt;&lt;br&gt;ComfyRuntimeSupervisor (child process, RuntimeLogHub), TcpPortProbe, YamlExtraModelPaths" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=1;" vertex="1" parent="infra"><mxGeometry x="20" y="124" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="inf3" value="&lt;b&gt;Python and packages&lt;/b&gt;&lt;br&gt;PythonAdapter, UvPackages, Wheels, PythonVerifier, SystemHardware (NVML)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=1;" vertex="1" parent="infra"><mxGeometry x="330" y="124" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="inf4" value="&lt;b&gt;Providers (HTTP)&lt;/b&gt;&lt;br&gt;Hugging Face, Civitai, Google Drive, Comfy Registry and GitHub clients" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=1;" vertex="1" parent="infra"><mxGeometry x="20" y="204" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="inf5" value="&lt;b&gt;Git&lt;/b&gt;&lt;br&gt;GitRepository / GitSource (ComfyUI checkout and updates), custom-node git installs" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=1;" vertex="1" parent="infra"><mxGeometry x="330" y="204" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="inf6" value="&lt;b&gt;Filesystem&lt;/b&gt;&lt;br&gt;LocalModelFiles, LocalGalleryFiles, LocalNodeFiles, OS trash" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=1;" vertex="1" parent="infra"><mxGeometry x="20" y="284" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="inf7" value="&lt;b&gt;Coordination&lt;/b&gt;&lt;br&gt;TokioMaintenanceGate, PathLocks, DownloadSupervisor / DownloadHub, logging" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#455a64;strokeWidth=1;" vertex="1" parent="infra"><mxGeometry x="330" y="284" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="x_sqlite" value="&lt;b&gt;SQLite DB&lt;/b&gt;&lt;br&gt;(install root)" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1080" y="1330" width="118" height="80" as="geometry"/></mxCell>
        <mxCell id="x_keyring" value="&lt;b&gt;OS keyring&lt;/b&gt;&lt;br&gt;(Credential Manager)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1208" y="1330" width="118" height="80" as="geometry"/></mxCell>
        <mxCell id="x_files" value="&lt;b&gt;Install root&lt;/b&gt;&lt;br&gt;models/&lt;br&gt;custom_nodes/&lt;br&gt;input/ · output/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1336" y="1330" width="118" height="80" as="geometry"/></mxCell>
        <mxCell id="x_net" value="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;HF · Civitai · Google Drive · GitHub · Registry · PyTorch" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1464" y="1330" width="118" height="80" as="geometry"/></mxCell>
        <mxCell id="x_comfy" value="&lt;b&gt;ComfyUI&lt;/b&gt;&lt;br&gt;Python process (127.0.0.1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1592" y="1330" width="118" height="80" as="geometry"/></mxCell>
        <mxCell id="example" value="&lt;b&gt;Example — rename a model&lt;/b&gt;: library page → gateway.modelRename() → invoke model_rename (ACL-checked) → library_commands::model_rename → input.location.into_domain() → RenameModel.execute() → ModelFiles + ModelCatalog ports → LocalModelFiles + SqliteCatalog → ModelLocationDto back to the UI. Downloads stream progress; node subscriptions stream changes and logs. Model and node rescans return results through invoke." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#fafafa;strokeColor=#999999;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="1330" width="1020" height="80" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;: solid arrow = runtime call or data flow · dashed hollow arrow = implements a port · feature colours = bounded context (see the DDD diagram)&lt;br&gt;&lt;b&gt;Compile-time rule&lt;/b&gt;: domain ← application ← infrastructure ← desktop; the manager UI reaches Rust through IPC (commands, Channels) and gallery:// — enforced by Cargo, scripts/check-arch-deps.mjs and ESLint boundaries" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#fafafa;strokeColor=#999999;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="1430" width="1700" height="60" as="geometry"/></mxCell>
