<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="dependency-injection" name="Dependency injection">
    <mxGraphModel dx="2610" dy="1664" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2610" pageHeight="1664" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Dependency injection&lt;/b&gt; — how AppState::compose() builds and wires the workspace" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2570" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="No DI container: crates/desktop/src/state.rs wires everything by hand. Adapters are built once and coerced to Arc&amp;lt;dyn Port + Send + Sync&amp;gt;; environment, custom nodes, ComfyUI runtime, library and gallery group theirs in one deps struct, and most of their use cases hold a clone of it; download and settings use cases take only the ports they name. A context that needs another receives that context's deps struct, one of its services, or the very same adapter instance. Tauri-bound adapters are installed after composition (OnceLock); a few dependencies are passed per call." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="2570" height="44" as="geometry"/></mxCell>
        <mxCell id="startup" value="Startup → composition → IPC" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#ede7f6;strokeColor=#5e35b1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="640" height="540" as="geometry"/></mxCell>
        <mxCell id="st_lib" value="&lt;b&gt;1 · lib.rs run() · setup()&lt;/b&gt;&lt;br&gt;manages StartupGate first (app_ready polls it) · spawns the startup thread" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="startup"><mxGeometry x="20" y="42" width="600" height="46" as="geometry"/></mxCell>
        <mxCell id="st_thread" value="&lt;b&gt;2 · startup thread&lt;/b&gt;&lt;br&gt;catch_unwind(state_factory): resolve_root → AppState::compose(root, DialogPicker); error → compose_recovery · then install_shell / install_clipboard / install_updater (OnceLocks)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="startup"><mxGeometry x="20" y="106" width="600" height="61" as="geometry"/></mxCell>
        <mxCell id="st_compose" value="&lt;b&gt;3 · AppState::compose()&lt;/b&gt; (crates/desktop/src/state.rs). Build order:&lt;br&gt;① AppPaths; read install.json → restricted? (root moved)&lt;br&gt;② one Db · SecretIngress + KeyringCredentialStore · SQLite settings / environment / relocation / runtime stores&lt;br&gt;③ NodeAdapters::open (SqliteNodes, RegistryHttp, LocalNodeFiles) → NodeRequirements&lt;br&gt;④ RuntimeLogHub → ComfyRuntimeSupervisor · GitSource · PythonVerifier&lt;br&gt;⑤ EnvironmentDeps (the root gate and FsRootSwitcher are created here)&lt;br&gt;⑥ ReconcileStartup; still restricted → SetupServices only, return&lt;br&gt;⑦ RuntimeAdapters · saved Settings · path_locks() → DownloadStack → LibraryStack → NodeAdapters::bind → Services::new&lt;br&gt;⑧ library reconcile · node reconcile + arm_scan (skipped while models are deferred) → AppState::new + opener" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#f3eefc;strokeColor=#5e35b1;strokeWidth=2;" vertex="1" parent="startup"><mxGeometry x="20" y="185" width="600" height="196" as="geometry"/></mxCell>
        <mxCell id="st_publish" value="&lt;b&gt;4 · StartupGate.publish&lt;/b&gt; → handle.manage(AppState) → start_services(): LibrarySupervisor::run_until · DownloadSupervisor::run (ReconcileOnStartup first) · ScanScheduler startup node scan · plus spawn_runtime_watch" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="startup"><mxGeometry x="20" y="399" width="600" height="61" as="geometry"/></mxCell>
        <mxCell id="st_ipc" value="&lt;b&gt;5 · IPC&lt;/b&gt;: #[tauri::command] fn x(state: State&amp;lt;'_, AppState&amp;gt;) → state.services()? → services.&amp;lt;context&amp;gt;.&amp;lt;use_case&amp;gt;.execute(dto.into_domain()?)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="startup"><mxGeometry x="20" y="478" width="600" height="46" as="geometry"/></mxCell>
        <mxCell id="boot" value="Boot modes" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="300" height="540" as="geometry"/></mxCell>
        <mxCell id="bm_normal" value="&lt;b&gt;Normal&lt;/b&gt;: Services + background tasks." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="boot"><mxGeometry x="10" y="42" width="280" height="91" as="geometry"/></mxCell>
        <mxCell id="bm_restricted" value="&lt;b&gt;Restricted (rebuild_required)&lt;/b&gt;: SetupServices only; its NodeService has no scan scheduler, so no scans run; root gate; opener installed." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="boot"><mxGeometry x="10" y="143" width="280" height="121" as="geometry"/></mxCell>
        <mxCell id="bm_deferred" value="&lt;b&gt;Deferred models (no &amp;lt;root&amp;gt;/ComfyUI yet)&lt;/b&gt;: downloads and library open without default roots; node reconcile and the startup scan are skipped." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="boot"><mxGeometry x="10" y="274" width="280" height="136" as="geometry"/></mxCell>
        <mxCell id="bm_recovery" value="&lt;b&gt;Recovery&lt;/b&gt;: credential use cases + opener only; fresh unshared gate." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="boot"><mxGeometry x="10" y="420" width="280" height="106" as="geometry"/></mxCell>
        <mxCell id="graph" value="Context injection graph" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#ffffff;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="1590" height="540" as="geometry"/></mxCell>
        <mxCell id="g_gal" value="Gallery" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="graph"><mxGeometry x="50" y="48" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="g_env" value="Environment" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="graph"><mxGeometry x="570" y="48" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="g_nodes" value="Custom Nodes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="graph"><mxGeometry x="1090" y="48" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="g_set" value="Settings" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="graph"><mxGeometry x="50" y="248" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="g_rt" value="ComfyUI Runtime" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="graph"><mxGeometry x="570" y="248" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="g_acq" value="Models › Acquisition" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="graph"><mxGeometry x="50" y="448" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="g_lib" value="Models › Library" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="graph"><mxGeometry x="570" y="448" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="cycles" value="&lt;b&gt;How cycles are broken&lt;/b&gt;&lt;br&gt;• Env ⇄ Runtime: the supervisor is built before EnvironmentDeps.&lt;br&gt;• Env ⇄ Nodes: NodeAdapters::open runs before EnvironmentDeps (NodeRequirements); bind(deps) runs after.&lt;br&gt;• Runtime ⇄ Nodes: NotifyingNodeLifecycle wraps a NodeService clone, and request_scan is a closure over Arc&amp;lt;ScanScheduler&amp;gt;.&lt;br&gt;• Env ⇄ Settings: FsRootSwitcher takes the SettingsRepository at construction." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#fafafa;strokeColor=#999999;strokeWidth=1;" vertex="1" parent="graph"><mxGeometry x="1090" y="403" width="480" height="121" as="geometry"/></mxCell>
        <mxCell id="ctx_env" value="Environment" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="460" height="578" as="geometry"/></mxCell>
        <mxCell id="ctx_env_lives" value="application/environment/deps.rs · built in compose() · SetupServices + env queries in Services · ipc/env_commands.rs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="ctx_env"><mxGeometry x="10" y="42" width="440" height="42" as="geometry"/></mxCell>
        <mxCell id="ctx_env_own" value="&lt;b&gt;Own adapters&lt;/b&gt;&lt;br&gt;hardware: HardwareProbe ← SystemHardware, catalog: ProfileCatalog ← BundledProfiles, curated: CuratedNodeCatalog ← BundledCuratedNodes, tools: ToolProvisioner ← Tools, python: PythonProvisioner ← PythonAdapter, packages: PackageInstaller ← UvPackages, wheels: WheelFetcher ← Wheels, verifier: EnvVerifier ← PythonVerifier, source: ComfySource ← GitSource, manager_config: ManagerConfigWriter ← FsManagerConfigWriter, envs · runs · activation · drafts: 4 ports ← one SqliteEnvironmentStore, manifests: InstallManifestStore ← FsManifestStore, installation: InstallationProbe ← FsInstallationProbe, relocation: RelocationStore ← SqliteRelocationStore, relocation_runtime: RuntimeMaintenance ← RelocationRuntimeGuard (environment adapter; process scan for roots the supervisor does not own), env_users: EnvironmentUsers ← ProcessEnvironmentUsers (outside programs running from an env), clock: SystemClock · ids: RandomIds, active_runs: ActiveRuns · plans: PlanStore (concrete)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#fafafa;strokeColor=#82b366;strokeWidth=1;fontColor=#555555;" vertex="1" parent="ctx_env"><mxGeometry x="10" y="88" width="440" height="223" as="geometry"/></mxCell>
        <mxCell id="ctx_env_oth" value="&lt;b&gt;From another context&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;&lt;b&gt;[Nodes]&lt;/b&gt;&lt;/font&gt; node_requirements: NodeRequirementSource ← NodeRequirements (over SqliteNodes + LocalNodeFiles ◆)&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;[Runtime]&lt;/b&gt;&lt;/font&gt; runtime: RuntimeMaintenance ← ComfyRuntimeSupervisor ◆" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="ctx_env"><mxGeometry x="10" y="319" width="440" height="72" as="geometry"/></mxCell>
        <mxCell id="ctx_env_shr" value="&lt;b&gt;◆ Shared stateful instances&lt;/b&gt;&lt;br&gt;root: RootSwitcher ← FsRootSwitcher ◆&lt;br&gt;gate: MaintenanceGate ← TokioMaintenanceGate (root gate) ◆" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="ctx_env"><mxGeometry x="10" y="399" width="440" height="58" as="geometry"/></mxCell>
        <mxCell id="ctx_env_held" value="&lt;b&gt;Held by&lt;/b&gt; 14 use cases (each holds a clone): GetSetupStatus, StartSetup, ExecuteSetup, CancelSetup, the queries, the package changes, DeleteEnvironment, and ReconcileStartup (which runs inside compose).&lt;br&gt;&lt;b&gt;Exceptions&lt;/b&gt;&lt;br&gt;• ExecuteSetup also takes &lt;font color=&quot;#9673a6&quot;&gt;&lt;b&gt;[Nodes]&lt;/b&gt;&lt;/font&gt; nodes: SetupNodes ← NodeService.&lt;br&gt;• InstallAppUpdate takes only gate · runtime · root." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#f7f7f7;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="ctx_env"><mxGeometry x="10" y="465" width="440" height="99" as="geometry"/></mxCell>
        <mxCell id="ctx_nodes" value="Custom Nodes" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="500" y="660" width="330" height="578" as="geometry"/></mxCell>
        <mxCell id="ctx_nodes_lives" value="application/custom_nodes/model.rs · built by NodeAdapters::bind (infrastructure/custom_nodes/stack.rs) · NodeServices · ipc/node_commands.rs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="ctx_nodes"><mxGeometry x="10" y="42" width="310" height="56" as="geometry"/></mxCell>
        <mxCell id="ctx_nodes_own" value="&lt;b&gt;Own adapters&lt;/b&gt;&lt;br&gt;registry: RegistryClient ← RegistryHttp (api.comfy.org), hook: NodeHook ← PythonHook, plans: NodePlans" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#fafafa;strokeColor=#9673a6;strokeWidth=1;fontColor=#555555;" vertex="1" parent="ctx_nodes"><mxGeometry x="10" y="102" width="310" height="58" as="geometry"/></mxCell>
        <mxCell id="ctx_nodes_oth" value="&lt;b&gt;From another context&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;[Env]&lt;/b&gt;&lt;/font&gt; environment: EnvironmentDeps clone (incl. root gate, RuntimeMaintenance, EnvironmentUsers)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1;" vertex="1" parent="ctx_nodes"><mxGeometry x="10" y="168" width="310" height="58" as="geometry"/></mxCell>
        <mxCell id="ctx_nodes_shr" value="&lt;b&gt;◆ Shared stateful instances&lt;/b&gt;&lt;br&gt;store: NodeRepository ← SqliteNodes ◆&lt;br&gt;files: NodeFiles ← LocalNodeFiles ◆&lt;br&gt;scans: ScanControl ◆&lt;br&gt;node_lock: MaintenanceGate ← a second TokioMaintenanceGate ◆ (not the root gate)&lt;br&gt;&lt;i&gt;Note: store and files also back NodeRequirements in EnvironmentDeps.&lt;/i&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;" vertex="1" parent="ctx_nodes"><mxGeometry x="10" y="234" width="310" height="127" as="geometry"/></mxCell>
        <mxCell id="ctx_nodes_held" value="&lt;b&gt;Held by&lt;/b&gt; NodeService ◆, one value cloned into NodeServices.service, SetupNodes (ExecuteSetup), NotifyingNodeLifecycle and ScanScheduler · LocateNode.&lt;br&gt;&lt;b&gt;Desktop&lt;/b&gt;: NodeServices { NodeStack (NodeHub ◆), service, locate, active ops (node_cancel), subscriptions, scheduler: Arc&amp;lt;ScanScheduler&amp;gt; }." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#f7f7f7;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="ctx_nodes"><mxGeometry x="10" y="369" width="310" height="99" as="geometry"/></mxCell>
        <mxCell id="ctx_rt" value="ComfyUI Runtime" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="850" y="660" width="350" height="578" as="geometry"/></mxCell>
        <mxCell id="ctx_rt_lives" value="application/comfy_runtime/ports.rs · built in compose() · ComfyServices · ipc/comfy_commands.rs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="ctx_rt"><mxGeometry x="10" y="42" width="330" height="42" as="geometry"/></mxCell>
        <mxCell id="ctx_rt_own" value="&lt;b&gt;Own adapters&lt;/b&gt;&lt;br&gt;store: RuntimeStore ← SqliteRuntimeStore, repository: ComfyRepository ← GitRepository (over the same GitSource), ports: PortProbe ← TcpPortProbe, preflight: LaunchPreflight ← PythonLaunchPreflight (PythonVerifier), extra_paths: ExtraModelPaths ← YamlExtraModelPaths" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#fafafa;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#555555;" vertex="1" parent="ctx_rt"><mxGeometry x="10" y="88" width="330" height="99" as="geometry"/></mxCell>
        <mxCell id="ctx_rt_oth" value="&lt;b&gt;From another context&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;[Env]&lt;/b&gt;&lt;/font&gt; environment: EnvironmentDeps clone&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;&lt;b&gt;[Nodes]&lt;/b&gt;&lt;/font&gt; nodes: NodeLifecycle ← NotifyingNodeLifecycle (desktop wrapper over NodeService; request_scan → ScanScheduler)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="ctx_rt"><mxGeometry x="10" y="195" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="ctx_rt_shr" value="&lt;b&gt;◆ Shared stateful instances&lt;/b&gt;&lt;br&gt;supervisor: RuntimeSupervisor ← ComfyRuntimeSupervisor ◆ (holds SharedRuntimeRunner, RuntimeLogHub ◆, SqliteRuntimeStore)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="ctx_rt"><mxGeometry x="10" y="288" width="330" height="72" as="geometry"/></mxCell>
        <mxCell id="ctx_rt_held" value="&lt;b&gt;Held by&lt;/b&gt; 7 use cases (each holds a clone): status, start, stop, restart, versions, read extra paths, UpdateComfy.&lt;br&gt;&lt;b&gt;Exceptions&lt;/b&gt;&lt;br&gt;• GetLaunchOptions / SetLaunchOptions take store only.&lt;br&gt;• ManageExtraModelPaths takes root (FsRootSwitcher) + writer: ExtraModelPathsWriter.&lt;br&gt;• ComfyServices.events: RuntimeEvents ← RuntimeLogHub ◆.&lt;br&gt;• CollectDiagnostics builds a second RuntimeDeps from the same adapters." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#f7f7f7;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="ctx_rt"><mxGeometry x="10" y="368" width="330" height="154" as="geometry"/></mxCell>
        <mxCell id="ctx_lib" value="Models › Library" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1220" y="660" width="330" height="578" as="geometry"/></mxCell>
        <mxCell id="ctx_lib_lives" value="application/models/library/operations.rs · built by LibraryStack::open (infrastructure/models/library/stack.rs) · LibraryServices · ipc/library_commands.rs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="ctx_lib"><mxGeometry x="10" y="42" width="310" height="56" as="geometry"/></mxCell>
        <mxCell id="ctx_lib_own" value="&lt;b&gt;Own adapters&lt;/b&gt;&lt;br&gt;catalog: ModelCatalog ← SqliteCatalog, files: ModelFiles ← LocalModelFiles, journal: OperationJournal ← SqliteJournal, control: LibraryControl ← LibrarySupervisor, details: ModelDetailsReader ← SidecarDetails, ids: RandomIds · clock: SystemClock (own instances), plans: DeletePlans" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#fafafa;strokeColor=#d6b656;strokeWidth=1;fontColor=#555555;" vertex="1" parent="ctx_lib"><mxGeometry x="10" y="102" width="310" height="113" as="geometry"/></mxCell>
        <mxCell id="ctx_lib_oth" value="&lt;b&gt;From another context&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;&lt;b&gt;[Settings]&lt;/b&gt;&lt;/font&gt; civitai: CivitaiLookup ← CivitaiClient (token from CredentialVault ← KeyringCredentialStore ◆)&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;[Runtime]&lt;/b&gt;&lt;/font&gt; LibraryRoots.extra: ExtraModelPaths ← YamlExtraModelPaths&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;&lt;b&gt;[Acq]&lt;/b&gt;&lt;/font&gt; set_reservations: DestinationReservations ← SqliteDownloads ◆" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="ctx_lib"><mxGeometry x="10" y="223" width="310" height="113" as="geometry"/></mxCell>
        <mxCell id="ctx_lib_shr" value="&lt;b&gt;◆ Shared stateful instances&lt;/b&gt;&lt;br&gt;locks: PathLocks ← shared PathLocks ◆" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="ctx_lib"><mxGeometry x="10" y="344" width="310" height="44" as="geometry"/></mxCell>
        <mxCell id="ctx_lib_held" value="&lt;b&gt;Held by&lt;/b&gt; 13 use cases (each holds a clone).&lt;br&gt;&lt;b&gt;Background&lt;/b&gt;: LibrarySupervisor::run_until (scan loop + watcher)." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#f7f7f7;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="ctx_lib"><mxGeometry x="10" y="396" width="310" height="58" as="geometry"/></mxCell>
        <mxCell id="ctx_acq" value="Models › Acquisition" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1570" y="660" width="380" height="578" as="geometry"/></mxCell>
        <mxCell id="ctx_acq_lives" value="no deps struct · DownloadStack (infrastructure/models/acquisition/stack.rs) · DownloadServices · ipc/download_commands.rs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="ctx_acq"><mxGeometry x="10" y="42" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="ctx_acq_ports" value="&lt;b&gt;Named ports (no deps struct)&lt;/b&gt;&lt;br&gt;repository: JobRepository ← SqliteDownloads ◆&lt;br&gt;resolver: SourceResolver ← ProviderResolver&lt;br&gt;files: DownloadFiles ← LocalDownloadFiles (ModelPathLocks ← shared PathLocks ◆)&lt;br&gt;packs: ModelPacks ← ResourcePacks&lt;br&gt;events: DownloadEvents / ProgressSink ← DownloadHub ◆&lt;br&gt;control: DownloadControl ← DownloadSupervisor ◆ (native · hf · gdown Downloader ← NativeDownloader · HfDownloader · GdownDownloader; one BandwidthLimiter)&lt;br&gt;tester: CredentialTester ← ProviderCredentialTester (&lt;font color=&quot;#666666&quot;&gt;&lt;b&gt;[Settings]&lt;/b&gt;&lt;/font&gt; CredentialVault ◆, Db ◆)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#fafafa;strokeColor=#d79b00;strokeWidth=1;fontColor=#555555;" vertex="1" parent="ctx_acq"><mxGeometry x="10" y="102" width="360" height="182" as="geometry"/></mxCell>
        <mxCell id="ctx_acq_uc" value="&lt;b&gt;Use case → ports&lt;/b&gt;&lt;br&gt;• ResolveDownload(resolver)&lt;br&gt;• EnqueueDownloads(resolver, repository, files, events, control)&lt;br&gt;• ResumeJob / RetryJob(repository, files, events, control), built by the resume closure&lt;br&gt;• PauseJob / CancelJob(control)&lt;br&gt;• ListJobs(repository)&lt;br&gt;• RemoveJob(repository, events)&lt;br&gt;• ImportPack(packs, resolver)&lt;br&gt;• ExportResourceList(packs)&lt;br&gt;• TestCredential(tester)&lt;br&gt;• ReconcileOnStartup + FinalizeDownload, built inside DownloadSupervisor::run" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#f7f7f7;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="ctx_acq"><mxGeometry x="10" y="292" width="360" height="196" as="geometry"/></mxCell>
        <mxCell id="ctx_acq_notes" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Finalize writes the library models table (JobRepository::catalog_and_mark).&lt;br&gt;• Concurrency and bandwidth come from saved Settings." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;" vertex="1" parent="ctx_acq"><mxGeometry x="10" y="496" width="360" height="72" as="geometry"/></mxCell>
        <mxCell id="ctx_gal" value="Gallery" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1970" y="660" width="270" height="578" as="geometry"/></mxCell>
        <mxCell id="ctx_gal_lives" value="application/gallery/use_cases.rs · built in compose() · GalleryServices · ipc/gallery_commands.rs · gallery_protocol.rs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="ctx_gal"><mxGeometry x="10" y="42" width="250" height="56" as="geometry"/></mxCell>
        <mxCell id="ctx_gal_own" value="&lt;b&gt;Own adapters&lt;/b&gt;&lt;br&gt;files: GalleryFiles ← LocalGalleryFiles, plans: GalleryDeletePlans" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#fafafa;strokeColor=#b85450;strokeWidth=1;fontColor=#555555;" vertex="1" parent="ctx_gal"><mxGeometry x="10" y="102" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="ctx_gal_oth" value="&lt;b&gt;From another context&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;[Env]&lt;/b&gt;&lt;/font&gt; root: RootSwitcher ← FsRootSwitcher ◆ (same Arc as EnvironmentDeps.root)&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;[Env]&lt;/b&gt;&lt;/font&gt; gate: MaintenanceGate ← root gate ◆&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;[Env]&lt;/b&gt;&lt;/font&gt; ids: IdGenerator ← the EnvironmentDeps RandomIds" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="ctx_gal"><mxGeometry x="10" y="168" width="250" height="99" as="geometry"/></mxCell>
        <mxCell id="ctx_gal_held" value="&lt;b&gt;Held by&lt;/b&gt; 7 use cases (each holds a clone). OpenGalleryMedia is served by gallery_protocol.rs." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#f7f7f7;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="ctx_gal"><mxGeometry x="10" y="275" width="250" height="58" as="geometry"/></mxCell>
        <mxCell id="ctx_set" value="Settings" style="swimlane;startSize=34;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=15;align=left;spacingLeft=12;collapsible=0;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2260" y="660" width="330" height="578" as="geometry"/></mxCell>
        <mxCell id="ctx_set_lives" value="no deps struct · on AppState + Services · ipc/commands.rs, app_commands.rs" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="ctx_set"><mxGeometry x="10" y="42" width="310" height="42" as="geometry"/></mxCell>
        <mxCell id="ctx_set_own" value="&lt;b&gt;Own adapters&lt;/b&gt;&lt;br&gt;• GetSettings / UpdateSettings: SettingsRepository ← SqliteSettingsRepository&lt;br&gt;• SetCredential / ClearCredential / GetCredentialStatus: CredentialStore ← KeyringCredentialStore ◆. They sit on AppState, so they work in recovery mode." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#fafafa;strokeColor=#666666;strokeWidth=1;fontColor=#555555;" vertex="1" parent="ctx_set"><mxGeometry x="10" y="88" width="310" height="99" as="geometry"/></mxCell>
        <mxCell id="ctx_set_oth" value="&lt;b&gt;From another context&lt;/b&gt;&lt;br&gt;• InstallAppUpdate: &lt;font color=&quot;#82b366&quot;&gt;&lt;b&gt;[Env]&lt;/b&gt;&lt;/font&gt; gate · runtime: RuntimeMaintenance · root, all from EnvironmentDeps, plus AppUpdater passed per call&lt;br&gt;• CollectDiagnostics: &lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;[Runtime]&lt;/b&gt;&lt;/font&gt; deps, a second RuntimeDeps over the same adapters · app_log: AppLogTail ← FileLogTail · runtime_log: RuntimeLogReader ← RuntimeLogHub ◆ · pinned tool versions" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="ctx_set"><mxGeometry x="10" y="195" width="310" height="141" as="geometry"/></mxCell>
        <mxCell id="ctx_set_held" value="&lt;b&gt;Desktop wiring&lt;/b&gt;&lt;br&gt;• settings_set (desktop) pushes concurrency and bandwidth into DownloadSupervisor / BandwidthLimiter&lt;br&gt;• TestCredential lives in DownloadServices." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#f7f7f7;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="ctx_set"><mxGeometry x="10" y="344" width="310" height="72" as="geometry"/></mxCell>
        <mxCell id="shared" value="Shared instances — one object, many holders" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#eeeeee;strokeColor=#666666;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="1258" width="1785" height="320" as="geometry"/></mxCell>
        <mxCell id="sh_db" value="&lt;b&gt;◆ Db&lt;/b&gt; (one wrapped Arc&amp;lt;Mutex&amp;lt;Connection&amp;gt;&amp;gt;, not a pool)&lt;br&gt;SqliteSettingsRepository · SqliteEnvironmentStore · SqliteRelocationStore · SqliteNodes · SqliteDownloads · SqliteCatalog + SqliteJournal · SqliteRuntimeStore · ProviderCredentialTester" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="10" y="42" width="345" height="122" as="geometry"/></mxCell>
        <mxCell id="sh_gate" value="&lt;b&gt;◆ Root TokioMaintenanceGate&lt;/b&gt;&lt;br&gt;EnvironmentDeps (so environment, runtime and node use cases) · GalleryDeps · InstallAppUpdate · AppState.gate · FsExistingInstallOpener. The node lock is a separate instance in NodeDeps. Recovery mode gets a fresh gate." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="365" y="42" width="345" height="122" as="geometry"/></mxCell>
        <mxCell id="sh_sup" value="&lt;b&gt;◆ ComfyRuntimeSupervisor&lt;/b&gt;&lt;br&gt;→ RuntimeSupervisor: ComfyServices + both RuntimeDeps · → RuntimeMaintenance: EnvironmentDeps.runtime (so environment and node use cases), InstallAppUpdate · per call: CloseCoordinator::prepare on close" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="720" y="42" width="345" height="122" as="geometry"/></mxCell>
        <mxCell id="sh_key" value="&lt;b&gt;◆ KeyringCredentialStore&lt;/b&gt;&lt;br&gt;→ CredentialStore: credential use cases · → CredentialVault: DownloadStack (hf engine, HTTP, tester), LibraryStack (CivitaiClient)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="1075" y="42" width="345" height="122" as="geometry"/></mxCell>
        <mxCell id="sh_locks" value="&lt;b&gt;◆ PathLocks&lt;/b&gt;&lt;br&gt;→ ModelPathLocks: LocalDownloadFiles · → PathLocks: LibraryDeps · LibraryRoots · DestinationReservations installed once from SqliteDownloads" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="1430" y="42" width="345" height="122" as="geometry"/></mxCell>
        <mxCell id="sh_root" value="&lt;b&gt;◆ FsRootSwitcher&lt;/b&gt;&lt;br&gt;→ RootSwitcher: EnvironmentDeps.root, GalleryDeps.root, ManageExtraModelPaths, InstallAppUpdate · holds SqliteSettingsRepository" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="10" y="174" width="345" height="136" as="geometry"/></mxCell>
        <mxCell id="sh_hub" value="&lt;b&gt;◆ RuntimeLogHub&lt;/b&gt;&lt;br&gt;→ RuntimeEvents: ComfyServices.events (spawn_runtime_watch, comfy_subscribe) · → RuntimeLogReader: CollectDiagnostics · held by ComfyRuntimeSupervisor" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="365" y="174" width="345" height="136" as="geometry"/></mxCell>
        <mxCell id="sh_node" value="&lt;b&gt;◆ NodeService · ScanControl · NodeHub&lt;/b&gt;&lt;br&gt;NodeService → NodeServices, SetupNodes, NotifyingNodeLifecycle, ScanScheduler · ScanControl → NodeDeps.scans, ScanScheduler; per call CloseCoordinator::prepare · NodeHub → ScanScheduler, NotifyingNodeLifecycle, per-operation HubSink, node_subscribe" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="720" y="174" width="345" height="136" as="geometry"/></mxCell>
        <mxCell id="sh_nf" value="&lt;b&gt;◆ SqliteNodes + LocalNodeFiles&lt;/b&gt;&lt;br&gt;→ NodeRequirements (EnvironmentDeps) and NodeDeps" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="1075" y="174" width="345" height="136" as="geometry"/></mxCell>
        <mxCell id="sh_dl" value="&lt;b&gt;◆ SqliteDownloads · DownloadHub · DownloadSupervisor&lt;/b&gt;&lt;br&gt;→ JobRepository (downloads) · DestinationReservations (shared PathLocks) · library models writes · DownloadEvents / ProgressSink → Enqueue, Resume, Remove, supervisor, dl_subscribe · DownloadControl → Enqueue, Resume, Pause, Cancel" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;" vertex="1" parent="shared"><mxGeometry x="1430" y="174" width="345" height="136" as="geometry"/></mxCell>
        <mxCell id="styles" value="Injection styles" style="swimlane;startSize=32;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;align=left;spacingLeft=12;collapsible=0;fillColor=#ede7f6;strokeColor=#5e35b1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1825" y="1258" width="765" height="320" as="geometry"/></mxCell>
        <mxCell id="sty_ctor" value="&lt;b&gt;Constructor&lt;/b&gt;, in compose(). FilePicker ← DialogPicker is a compose() argument." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="styles"><mxGeometry x="10" y="42" width="745" height="31" as="geometry"/></mxCell>
        <mxCell id="sty_once" value="&lt;b&gt;OnceLock after compose&lt;/b&gt; (lib.rs):&lt;br&gt;• ShellActions ← TauriShell&lt;br&gt;• Clipboard ← TauriClipboard (fallback UnavailableClipboard)&lt;br&gt;• AppUpdater ← SignedUpdater over ReleaseChannel / Release / Quiesce ← PluginChannel / PluginRelease / AppQuiesce (fallback SignedUpdater::disabled())" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="styles"><mxGeometry x="10" y="81" width="745" height="91" as="geometry"/></mxCell>
        <mxCell id="sty_call" value="&lt;b&gt;Per call&lt;/b&gt;:&lt;br&gt;• InstallAppUpdate.execute(updater, …)&lt;br&gt;• CloseCoordinator::prepare(gate, ScanControl, RuntimeSupervisor, root, stop)&lt;br&gt;• NodeContext { cancel, sink: HubSink }&lt;br&gt;• SetupProgressSink / UpdateProgressSink ← ChannelSink" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="styles"><mxGeometry x="10" y="180" width="745" height="91" as="geometry"/></mxCell>
        <mxCell id="sty_cmd" value="&lt;b&gt;Into commands&lt;/b&gt;: Tauri managed State&amp;lt;'_, AppState&amp;gt; → services()? (a recovery error when absent)." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;strokeWidth=1;" vertex="1" parent="styles"><mxGeometry x="10" y="279" width="745" height="31" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;: injection graph A → B = A holds an object built for or by B · solid edge = injected object · dashed edge = coupling without injection · ◆ = shared stateful instance (see Shared instances) · [Env] / [Runtime] / [Nodes] / [Acq] / [Settings] = field provided by another context · ports are Arc&amp;lt;dyn Trait + Send + Sync&amp;gt;; generics appear only on Tauri-runtime adapters (TauriShell&amp;lt;R&amp;gt; …) · card colours = bounded-context colours on the other two diagrams · source of truth: crates/desktop/src/state.rs AppState::compose()" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fontSize=12;fillColor=#fafafa;strokeColor=#999999;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="1598" width="2570" height="46" as="geometry"/></mxCell>
        <mxCell id="e6" value="root · gate · ids" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;labelBackgroundColor=#ffffff;strokeWidth=1.5;fontSize=12;exitX=1;exitY=0.2368;exitDx=0;exitDy=0;entryX=0;entryY=0.2368;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_gal" target="g_env"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
