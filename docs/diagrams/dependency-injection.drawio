        <mxCell id="e2" value="NodeDeps.environment&lt;br&gt;(incl. gate, RuntimeMaintenance)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;labelBackgroundColor=#ffffff;strokeWidth=1.5;fontSize=12;exitX=0;exitY=0.7632;exitDx=0;exitDy=0;entryX=1;entryY=0.7632;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_nodes" target="g_env"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="24" as="offset"/></mxGeometry></mxCell>
